<?xml version="1.0" encoding="utf-8"?>
<!--
  개발(debug) 빌드 전용 매니페스트.
  쉐도우 코치 인앱 "화면 녹화"(MediaProjection) 관련 권한·서비스를 여기에만 선언한다.
  스켈레톤·카운트 칩까지 입혀 갤러리(Movies/ShadowCoach)에 저장하는 튜닝용 기능이며,
  release(Play Store) 빌드엔 병합되지 않아 권한·서비스가 포함되지 않는다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 9 이하(API 26~28): MediaStore(공유 Movies) 저장에 필요. Q+ 는 scoped storage 라 불필요. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 화면 녹화용 포그라운드 서비스(MediaProjection). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <service
            android:name="com.unboundapex.octalink.data.shadowcoach.ShadowScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
