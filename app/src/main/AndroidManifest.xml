<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FCM: Android 13(API 33)+ 알림 표시 권한. 실제 runtime 요청은 푸시 알림 작업 시점에. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AdMob 사용 → 광고 ID 권한 필요. Play Console 의 광고 ID 선언 "예" 와 일치. -->
    <!-- (Phase 1 이전 광고 미사용 시점엔 tools:node="remove" 로 제거했으나 복원함) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".OctaLinkApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OctaLink">

        <!-- AdMob 앱 ID. 실제 배포 시 user 의 admob.google.com 앱 ID 로 교체.
             현재는 Google 공식 테스트 앱 ID (Android) 사용 — 실제 광고 비노출, 정책 위반 없음. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OctaLink.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 메시지 수신 + 토큰 갱신 핸들러 (mvp 단계: 로그만, 실제 알림 표시는 푸시 알림 작업 시점) -->
        <service
            android:name=".messaging.OctaLinkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 카카오 로그인 OAuth 콜백 핸들러 (Custom URL scheme). -->
        <!-- scheme 형식: kakao{NATIVE_APP_KEY}://oauth — build.gradle.kts manifestPlaceholder 로 주입 -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>

        <!-- 이미지 공유용 FileProvider — 캐시 디렉토리의 이미지를 다른 앱(카카오톡/인스타)에 안전하게 전달. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- 외부 앱 패키지 가시성 (Android 11+) — startActivity 로 카카오톡/인스타 호출 위해 필요. -->
    <queries>
        <package android:name="com.kakao.talk" />
        <package android:name="com.instagram.android" />
    </queries>
</manifest>
