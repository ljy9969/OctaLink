// OctaLink Firestore Security Rules — v2 (2026-05-11, CREATOR 추가)
//
// 권한 모델 4단계 (코드 sync: Schema.kt + RoleAllowlist.kt):
//   MEMBER  : 본인 출결/프로필/스킬 점수 read + 커뮤니티 글 작성
//   COACH   : 운영진 일상 작업 (코멘트/출결검토/토너먼트/공지/스킬점수 입력 PROPOSED)
//   MASTER  : 운영 전권 (스킬점수 검토·확정 / 회원 가입 승인). 단 권한 부여는 ❌
//   CREATOR : 앱 제작자. MASTER 전 권한 + 회원 역할 부여(코치 승격) **단독**.
//             관장 계정 탈취 시 권한 상승 공격 차단 위해 격리
//
// 컬렉션 경로 (Schema.kt Collections object 따름):
//   members/{uid}                                  (회원 마스터)
//   members/{uid}/attendance/{attendanceId}        (출석 서브컬렉션)
//   members/{uid}/comments/{commentId}             (한 줄 코멘트, 본인 수신)
//   members/{uid}/skillScores/{scoreId}            (스킬 점수 스냅샷)
//   classDefs/{classId}                            (정기 클래스 정의)
//   tournaments/{tournamentId}                     (토너먼트)
//   tournaments/{tournamentId}/matches/{matchId}   (매치 서브컬렉션)
//   posts/{postId}                                 (커뮤니티 글)
//
// 가입 플로우 (Cloud Function 권장):
//   1. 카카오 OAuth → Firebase Custom Token 교환 → Auth signInWithCustomToken
//   2. Cloud Function (auth onCreate trigger)이 server-side allowlist 조회
//   3. allowlist masters/coaches → role 부여 + status APPROVED + members/{uid} 생성
//      그 외 → role MEMBER + status PENDING → 관장 승인 대기
//   클라이언트 직접 members 생성은 차단 (privilege escalation 방지)
//
// 배포:
//   - 콘솔: Firebase Console → Firestore Database → 규칙 탭에 붙여넣기 → 게시
//   - CLI:  firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════
    // Helper 함수
    // ════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    /** APPROVED 상태인 회원 (PENDING/REJECTED/SUSPENDED 차단) */
    function isApproved() {
      return isAuth() && memberDoc().status == 'APPROVED';
    }

    /** 운영진 (관장 + 코치 + 창조자) */
    function isStaff() {
      return isApproved() && memberDoc().role in ['MASTER', 'COACH', 'CREATOR'];
    }

    /** 관장급 이상 (MASTER + CREATOR) — 스킬 검토 / 회원 가입 승인 등 운영 최상위 */
    function isMaster() {
      return isApproved() && memberDoc().role in ['MASTER', 'CREATOR'];
    }

    /** 앱 제작자 단독 — 회원 역할 부여(코치 승격) 등 최상위 권한 */
    function isCreator() {
      return isApproved() && memberDoc().role == 'CREATOR';
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /**
     * AI 보강 루틴 (Phase 1 베타) 접근 화이트리스트 — CREATOR + 명시된 uid.
     * 클라이언트 [AiRoutineAccess.kt] / Cloud Function [AI_ROUTINE_BETA_UIDS] 와 동일하게 유지.
     */
    function canUseAiRoutine() {
      return isCreator() || request.auth.uid == 'kakao:4892939648';
    }

    /** 본인 프로필 수정 시 변경 허용 필드만 (role/status/id/createdAt/joinDate 보호) */
    function memberSelfEditableOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'belt', 'avatarId', 'phone', 'fcmToken', 'notificationPrefs', 'classReminderSlots', 'updatedAt']);
    }

    /** 역할(role) 필드 변경 여부 — 관장은 role 못 바꾸도록 강제 */
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // ════════════════════════════════════════════════════════
    // CollectionGroup 쿼리 룰 (recursive wildcard)
    // ════════════════════════════════════════════════════════
    //
    // Firestore 는 collectionGroup 쿼리를 일반 doc 액세스와 다르게 평가한다.
    // 특정 부모 경로 룰(`match /members/{uid}/attendance/...`) 은 collectionGroup
    // 쿼리에 적용되지 않으므로 `{path=**}` recursive wildcard 로 별도 선언 필요.
    //
    // 클라이언트 사용처: AttendanceScreen 의 "오늘 함께하는 동료" 카드 —
    // `db.collectionGroup("attendance").whereEqualTo("classDate", today)` 로
    // 모든 회원의 출석 doc 을 한 번에 스캔.
    //
    // 권한: APPROVED 회원만 list/get. write 는 nested 룰(아래 members 안) 에서 분기.
    match /{path=**}/attendance/{attendanceId} {
      allow read: if isApproved();
    }

    // 운영진 스킬 점수 리뷰 큐 — `db.collectionGroup("skillScores").whereEqualTo("status", "PROPOSED")`
    // 으로 전 회원 PROPOSED 점수를 한 번에 스캔. 본인 read 는 아래 nested 룰이 담당.
    //
    // 권한: 운영진만 (개인 점수 노출 방지 — 일반 회원은 본인 nested 경로로만 접근).
    // firestore.indexes.json 의 (status ASC, evaluatedAt ASC) collection-group composite index 필요.
    match /{path=**}/skillScores/{scoreId} {
      allow read: if isStaff();
    }

    // ════════════════════════════════════════════════════════
    // members — 회원 마스터
    // ════════════════════════════════════════════════════════
    match /members/{uid} {
      // get: 본인 own doc 은 unconditional (가입 부트스트랩 — 아직 MemberDoc 없는 신규 카카오 가입자도
      //      자기 doc 존재 여부 확인 가능). 그 외엔 APPROVED 회원만.
      // list: APPROVED 회원만 (출석 동료 표시 / 창조자 페이지 / draw 풀 등 list 쿼리)
      allow get: if isSelf(uid) || isApproved();
      allow list: if isApproved();

      // create는 Cloud Function (admin SDK)만. 클라이언트 직접 차단.
      // → role/status를 클라이언트가 임의로 결정할 수 없게 막음
      allow create: if false;

      // update 권한 3단계:
      //   1. 본인: 안전 필드만 (name/belt/avatarId/phone/updatedAt)
      //   2. 관장: role 외 모든 필드 (status APPROVED 승인, 정보 정정 등). **role 변경 ❌**
      //   3. 창조자: 전체 필드 (role 변경 포함, 회원 → 코치 승격 등)
      allow update: if (
        isSelf(uid) && memberSelfEditableOnly()
      ) || (
        isMaster() && roleUnchanged()
      ) || (
        isCreator()
      );

      allow delete: if isCreator();

      // ─────────────────────────────────────
      // attendance 서브컬렉션
      // ─────────────────────────────────────
      match /attendance/{attendanceId} {
        // 모든 APPROVED 회원이 read 가능 — 동료 출석 표시(AttendanceScreen) +
        // collectionGroup 쿼리("오늘 출석한 사람 전체") 통과 필요.
        // 본인 / 운영진은 자신 / 모든 회원의 출결 검토 가능 (read 권한 동일)
        allow read: if isApproved();

        // TODO(attendance-lockdown): 베타 APK 전원 업데이트 후 락다운 rules 로 교체
        //   (Cloud Function recordAttendance/cancelAttendance 만 통과). 임시로 기존 규칙 유지.

        // create: 본인만 자기 체크인 (memberId 위조 방지).
        // 관장(MASTER) 은 영업일 상시 운영 — 출석 체크인 불가 (UI 도 비활성).
        allow create: if isSelf(uid)
          && request.resource.data.memberId == uid
          && memberDoc().role != 'MASTER';

        // update: 본인 재체크인(checkInAt 갱신) + 운영진의 verified 토글.
        // 운영진이 memberId 변경하지 못하도록 resource.data.memberId 일치 강제.
        allow update: if (isSelf(uid) && request.resource.data.memberId == uid)
          || (isStaff() && request.resource.data.memberId == resource.data.memberId);

        // delete: 본인이 자기 체크인 취소 + 운영진은 다른 회원 출결 정정/삭제
        allow delete: if isSelf(uid) || isStaff();
      }

      // ─────────────────────────────────────
      // comments 서브컬렉션 (관장→회원 단방향, 본인 수신 전용)
      // ─────────────────────────────────────
      match /comments/{commentId} {
        // 본인이 받은 것 + 운영진(작성/검토용) read
        allow read: if isSelf(uid) || isStaff();

        // 운영진만 작성. byMasterId는 작성자 본인이어야 함 (위조 방지)
        allow create: if isStaff()
          && request.resource.data.toMemberId == uid
          && request.resource.data.byMasterId == request.auth.uid;

        // 본인이 작성한 코멘트만 수정/삭제 가능
        allow update, delete: if isStaff()
          && resource.data.byMasterId == request.auth.uid;
      }

      // ─────────────────────────────────────
      // skillScores 서브컬렉션 (코치 입력 PROPOSED → 관장 APPROVED)
      // ─────────────────────────────────────
      match /skillScores/{scoreId} {
        allow read: if isSelf(uid) || isStaff();

        // 운영진(코치+관장) 의 PROPOSED 입력 (코치 제안 흐름).
        // 또는 관장의 직접 평가 — PROPOSED 단계 건너뛰고 즉시 APPROVED 로 생성.
        // 직접 평가는 reviewedByMasterId == 본인 (= byUserId) 으로 자기 명의 강제.
        allow create: if (
          isStaff()
            && request.resource.data.memberId == uid
            && request.resource.data.byUserId == request.auth.uid
            && request.resource.data.status == 'PROPOSED'
        ) || (
          isMaster()
            && request.resource.data.memberId == uid
            && request.resource.data.byUserId == request.auth.uid
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.reviewedByMasterId == request.auth.uid
        );

        // 관장만 PROPOSED → APPROVED/REJECTED 전환. 점수 자체는 immutable.
        allow update: if isMaster()
          && resource.data.status == 'PROPOSED'
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reviewedByMasterId', 'reviewedAt']);

        allow delete: if isMaster();
      }

      // ─────────────────────────────────────
      // weeklyRoutines 서브컬렉션 (AI 가 생성한 주간 보강 루틴)
      // doc id = ISO week key ("2026-W22"). 생성/덮어쓰기는 Cloud Function
      // (`generateWeeklyRoutine`) admin SDK 가 담당 → 클라이언트 write 차단.
      //
      // **Phase 1 베타 단계** — Vertex AI 비용 통제 위해 read/update 모두 CREATOR 단독.
      // 사용량 모니터링 + 추천 품질 검증 끝나면 isSelf/isStaff 로 완화 예정.
      // ─────────────────────────────────────
      match /weeklyRoutines/{weekId} {
        // 베타 화이트리스트 (CREATOR + 명시 uid) 중 본인 doc 만 read.
        // CREATOR 는 운영자라 다른 회원 doc 도 read 허용.
        allow read: if isCreator() || (canUseAiRoutine() && isSelf(uid));

        // create/delete 는 클라이언트 차단 (Cloud Function admin 만).
        allow create, delete: if false;

        // 드릴 단위 done/skipped 토글 — 베타 화이트리스트 본인만.
        allow update: if canUseAiRoutine()
          && isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days']);
      }
    }

    // ════════════════════════════════════════════════════════
    // classDefs — 정기 클래스 정의
    // ════════════════════════════════════════════════════════
    match /classDefs/{classId} {
      allow read: if isApproved();
      allow write: if isMaster();  // 운영 일정 변경은 관장만
    }

    // ════════════════════════════════════════════════════════
    // tournaments — 토너먼트
    // ════════════════════════════════════════════════════════
    match /tournaments/{tournamentId} {
      allow read: if isApproved();
      allow create, update, delete: if isStaff();

      // ─────────────────────────────────────
      // matches 서브컬렉션
      // ─────────────────────────────────────
      match /matches/{matchId} {
        allow read: if isApproved();
        allow create, update, delete: if isStaff();
      }
    }

    // ════════════════════════════════════════════════════════
    // posts — 커뮤니티 글 (NOTICE/RECORD/TIP/QUESTION)
    // ════════════════════════════════════════════════════════
    match /posts/{postId} {
      // 읽기 — visibility 기반 접근 제어:
      //   PUBLIC: 모든 APPROVED 회원
      //   PENDING_APPROVAL: 작성자 본인 + 멘션된 회원만
      //   REJECTED: 작성자 본인 + 멘션된 회원만 (정리/재게시 결정 위해)
      //   (기존 doc 호환: visibility 필드 없으면 PUBLIC 으로 간주)
      allow read: if isApproved() && (
        !('visibility' in resource.data)
        || resource.data.visibility == 'PUBLIC'
        || resource.data.authorId == request.auth.uid
        || request.auth.uid in resource.data.get('mentionedMemberIds', [])
      );

      // 작성: 모든 APPROVED. NOTICE 태그는 운영진만. authorId 위조 차단.
      // 미디어+멘션 조합 → PENDING_APPROVAL 초기 상태로 작성됨 (클라가 set).
      allow create: if isApproved()
        && request.resource.data.authorId == request.auth.uid
        && (request.resource.data.tag != 'NOTICE' || isStaff());

      // 수정 — 세 케이스:
      //   (a) 좋아요 토글: 모든 APPROVED 가 likedBy 만 변경
      //   (b) 본인 글 본문 편집: **작성자 전용**. authorId/createdAt 불변.
      //       NOTICE 태그 부여/유지 변경은 변경자가 운영진일 때만.
      //   (c) 멘션 승인/거부 (visibility / pendingApprovalFrom / rejectedBy 만 변경):
      //       멘션된 회원이 본인 id 를 pendingApprovalFrom 에서 제거 또는 rejectedBy 에 추가.
      //       서버측 정밀 검증은 향후 Cloud Function 으로 강화 가능.
      allow update: if (
        isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
      ) || (
        isApproved()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['visibility', 'pendingApprovalFrom', 'rejectedBy'])
        && request.auth.uid in resource.data.get('mentionedMemberIds', [])
      ) || (
        resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.tag != 'NOTICE' || isStaff())
      );

      // 삭제: 본인 글 + 관장급(MASTER/CREATOR) 모더레이션. 코치는 제외 (모더레이션 권한 분리).
      allow delete: if isApproved()
        && (resource.data.authorId == request.auth.uid || isMaster());

      // ─────────────────────────────────────
      // posts/{postId}/postComments/{commentId} — 글 댓글
      // 이름이 postComments 인 이유: members/{uid}/comments 와 collectionGroup 충돌 회피.
      // 권한 정책은 부모 글(posts)과 동일:
      //   read: 모든 APPROVED. create: APPROVED + authorId 위조 차단.
      //   update: 작성자 본인만 (운영진도 남의 댓글 본문 못 바꿈).
      //   delete: 작성자 + 관장급(MASTER/CREATOR) 모더레이션. 코치 제외.
      // ─────────────────────────────────────
      match /postComments/{commentId} {
        allow read: if isApproved();

        allow create: if isApproved()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId;

        // (a) 좋아요 토글: 모든 APPROVED 가 likedBy 만 변경.
        // (b) 본인 본문 편집: 작성자만, body/updatedAt 만 변경.
        allow update: if (
          isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        ) || (
          resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['body', 'updatedAt'])
        );

        allow delete: if isApproved()
          && (resource.data.authorId == request.auth.uid || isMaster());
      }
    }

    // collectionGroup("postComments") — 카드 목록의 댓글 카운트 배지 집계용.
    // 모든 APPROVED 회원이 전 글의 댓글 카운트를 보는 게 의도된 노출.
    match /{path=**}/postComments/{commentId} {
      allow read: if isApproved();
    }

    // ════════════════════════════════════════════════════════
    // gymSettings — 도장 전역 설정 (주간 미션 등 singleton doc)
    // ════════════════════════════════════════════════════════
    match /gymSettings/{settingId} {
      allow read: if isApproved();       // 회원 누구나 (홈 카드에 노출)
      allow write: if isStaff();         // 운영진만 작성/수정
    }

    // ════════════════════════════════════════════════════════
    // 매칭 안 된 모든 경로 명시적 거부 (allowlist 모델)
    // ════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
