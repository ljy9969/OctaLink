# ops/mcp/.env — 자격증명 슬롯. 실제 .env 는 git에 올리지 않음.
# 값을 채우면 해당 provider/커넥터가 활성화됩니다. 비우면 dryrun 폴백.

# --- 모델 provider (버전은 apply-profile로 선택) ---
OPENROUTER_API_KEY=          # 버전 A: 8 에이전트 오픈소스 모델 (openrouter.ai)
OLLAMA_URL=http://localhost:11434   # 버전 C: 로컬 Ollama(무료·키 불필요). 기본값이면 비워둬도 됨
ANTHROPIC_API_KEY=           # (선택) anthropic provider용 API 키 — 크레딧 필요

# --- 엔진 안전 ---
DAILY_CAP_USD=5              # 하루 총비용 kill-switch

# --- 커넥터(Phase 2, 해당 에이전트 켤 때) ---
SEARXNG_URL=               # research 웹검색(권장): self-host SearXNG의 JSON 주소(예: http://localhost:8888). 키 불필요·가장 안정
GOOGLE_CSE_ID=             # (사실상 불가) Custom Search JSON API 신규 발급 중단 → 403. 기존 접근권 있는 프로젝트만 사용 가능
GOOGLE_API_KEY=            # Custom Search용 키(비우면 YOUTUBE_API_KEY 재사용) — CSE 자체가 막혀 무의미
# (키/설정 아무것도 없으면 무료 DuckDuckGo로 폴백 — 지금 기본 동작)
GH_TOKEN=                    # dev 이벤트 트리거: GitHub 이슈 배정 폴링(fine-grained PAT, Issues read)
FIREBASE_SERVICE_ACCOUNT=    # 앱 데이터(Firestore) 조회 — payments/bug/research
INSTAGRAM_TOKEN=             # social 게시: Meta 그래프 API 장기 토큰(비밀번호 아님, runbooks/instagram.md)
IG_USER_ID=             # social/support
THREADS_TOKEN=
META_ADS_TOKEN=              # ads (집행은 승인 게이트)
YOUTUBE_API_KEY=            # research 선수 채널 발굴(YouTube Data API v3, 무료)
GOOGLE_ADS_TOKEN=
TOSS_PAYMENTS_SECRET=        # payments 대사 (또는 STRIPE_SECRET)
